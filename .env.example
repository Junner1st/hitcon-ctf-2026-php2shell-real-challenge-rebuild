# Copy to .env for local defaults, or select checked-in presets with multiple
# --env-file arguments (see README.md).
FPM_A_PORT=18081
FPM_B_PORT=18082
APACHE_PORT=18083
TARGET_PLATFORM=linux/amd64

# Default: report-observed 5.6.35/7.4.24 and calibrated 8.4.26 lab build.
FPM_A_PHP_IMAGE=php:5.6.35-fpm
FPM_A_WORDPRESS_VERSION=5.7.20
FPM_A_BUILD_TAG=php5.6.35-wp5.7.20
FPM_B_PHP_IMAGE=php:7.4.24-fpm
FPM_B_WORDPRESS_VERSION=6.9.5
FPM_B_BUILD_TAG=php7.4.24-wp6.9.5
APACHE_PHP_IMAGE=php:8.4.26-apache
APACHE_WORDPRESS_VERSION=6.8.3
APACHE_BUILD_TAG=php8.4.26-wp6.8.3

# Default worker mode: small-pool. Traffic is off unless profile traffic is used.
APACHE_START_SERVERS=1
APACHE_MIN_SPARE_SERVERS=1
APACHE_MAX_SPARE_SERVERS=4
APACHE_MAX_REQUEST_WORKERS=4
APACHE_MAX_CONNECTIONS_PER_CHILD=0
APACHE_CONTAINER_MEMORY=1g
APACHE_CONTAINER_PIDS=128

# Optional target restriction for background traffic:
# TRAFFIC_ORIGINS=http://wp-apache
# TRAFFIC_ORIGINS=http://nginx-fpm-a http://nginx-fpm-b
