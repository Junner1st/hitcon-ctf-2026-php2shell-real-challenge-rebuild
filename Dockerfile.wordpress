ARG PHP_BASE_IMAGE=php:8.4.26-apache

FROM alpine:3.22 AS wordpress-source
ARG WORDPRESS_VERSION=6.8.3
RUN wget -q "https://wordpress.org/wordpress-${WORDPRESS_VERSION}.tar.gz" -O /tmp/wordpress.tar.gz \
    && mkdir /wordpress \
    && tar -xzf /tmp/wordpress.tar.gz --strip-components=1 -C /wordpress

FROM ${PHP_BASE_IMAGE}
ARG TARGET_SAPI=apache

RUN docker-php-ext-install mysqli \
    && if [ "$TARGET_SAPI" = apache ]; then a2enmod rewrite; fi

COPY --from=wordpress-source /wordpress /usr/src/wordpress
COPY scripts/wordpress-entrypoint.sh /usr/local/bin/php2shell-wordpress-entrypoint
COPY apache/php2shell-workers.sh /usr/local/bin/php2shell-apache-workers

RUN chmod 0755 /usr/local/bin/php2shell-wordpress-entrypoint /usr/local/bin/php2shell-apache-workers \
    && chown -R www-data:www-data /usr/src/wordpress

WORKDIR /var/www/html
ENTRYPOINT ["php2shell-wordpress-entrypoint"]
CMD ["php-fpm"]
